        {
          "id": "a835de7",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Reliable infrastructure that protects public health and preserves resources</p>\n      </div>\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Corrosion &amp; UV Resistant</h3>\n            <p>Corrosion, UV, and chemical resistant for long-lasting underground and exposed installations.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"/></svg>\n            </div>\n            <h3>Smooth Flow &amp; Leak-Free</h3>\n            <p>Smooth flow and leak-free joints for efficient water distribution and reduced water loss.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; Easy to Install</h3>\n            <p>Lightweight and easy to install, reducing labor costs and installation time.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n            </div>\n            <h3>Quieter Than Metal</h3>\n            <p>Quieter than metal pipes with smoother interior surfaces for improved flow rates.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Energy Efficient</h3>\n            <p>Energy efficient with long service life, reducing pumping costs and long-term maintenance.</p>\n          </div>\n\n        </div>\n      </div>\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
