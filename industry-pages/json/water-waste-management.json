          "id": "2607df5",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Corrosion-resistant plastics for safe, sustainable water infrastructure</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">PVC</span>\n      <span class=\"material-tag\">CPVC</span>\n      <span class=\"material-tag\">HDPE</span>\n      <span class=\"material-tag\">LDPE</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">PVDF</span>\n      <span class=\"material-tag\">PMP</span>\n      <span class=\"material-tag\">UHMW-PE</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
