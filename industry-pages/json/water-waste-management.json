      "elements": [
        {
          "id": "4881c62",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Water and waste management plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-potable\" id=\"tab-potable\">Potable &amp; Distribution</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-treatment\" id=\"tab-treatment\">Treatment &amp; Reclamation</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-potable\" aria-labelledby=\"tab-potable\">\n            <ul class=\"applications__list\">\n              <li>Potable water pipes, pumps, and valves</li>\n              <li>Irrigation systems and aquaculture equipment</li>\n              <li>Hot and cold water distribution systems</li>\n              <li>Plumbing pipes and fittings</li>\n              <li>Double-contained piping systems</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-treatment\" aria-labelledby=\"tab-treatment\">\n            <ul class=\"applications__list\">\n              <li>Sewage treatment paddles, chains, and guides</li>\n              <li>Desalination plant systems</li>\n              <li>Reclamation and wastewater piping</li>\n              <li>Submerged installations and marine water systems</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
