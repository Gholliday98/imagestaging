          "id": "c6884c5",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Strong, weather-resistant plastics for construction and heavy machinery</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">FRP</span>\n      <span class=\"material-tag\">HDPE</span>\n      <span class=\"material-tag\">UHMW-PE</span>\n      <span class=\"material-tag\">Nylon (PA)</span>\n      <span class=\"material-tag\">PET</span>\n      <span class=\"material-tag\">PVC</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
