      "elements": [
        {
          "id": "57ad54b",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Construction and heavy equipment plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-construction\" id=\"tab-construction\">Construction</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-equipment\" id=\"tab-equipment\">Heavy Equipment</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-construction\" aria-labelledby=\"tab-construction\">\n            <ul class=\"applications__list\">\n              <li>Skylights, glazing, and roofing systems</li>\n              <li>Entry canopies and security windows</li>\n              <li>Sound barriers and interior partitions</li>\n              <li>Wall panels and decorative finishes</li>\n              <li>Piping, wiring jacketing, and caulking</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-equipment\" aria-labelledby=\"tab-equipment\">\n            <ul class=\"applications__list\">\n              <li>Heavy equipment bushings, bearings, and rollers</li>\n              <li>Wear pads, seals, and liners</li>\n              <li>Chutes and guards for industrial equipment</li>\n              <li>Outrigger pads, stairs, and grating</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
