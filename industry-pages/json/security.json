          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>High-strength, impact-resistant plastics for security and protective applications</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">Ionomer</span>\n      <span class=\"material-tag\">Reinforced Thermoplastics (KEVLAR&reg; blends)</span>\n    </div>\n  </section>"
