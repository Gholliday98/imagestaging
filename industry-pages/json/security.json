        {
          "id": "633379e",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/security2.jpeg\" alt=\"Security glazing and protective plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-commercial\" id=\"tab-commercial\">Commercial &amp; Government</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-tactical\" id=\"tab-tactical\">Tactical &amp; Military</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-weather\" id=\"tab-weather\">Weather &amp; Infrastructure</button>\n          </div>\n\n          <!-- Panel: Commercial & Government -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-commercial\" aria-labelledby=\"tab-commercial\">\n            <ul class=\"applications__list\">\n              <li>Bank teller and cashier windows</li>\n              <li>Convenience store and gas station glazing</li>\n              <li>Courtroom shields and judge&rsquo;s bench barriers</li>\n              <li>Embassy and government windows</li>\n              <li>Prison and detention center glazing</li>\n              <li>Security entryways and bulletproof partitions</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Tactical & Military -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-tactical\" aria-labelledby=\"tab-tactical\">\n            <ul class=\"applications__list\">\n              <li>Military and police face shields</li>\n              <li>Riot shields and protective barriers</li>\n              <li>VIP and military vehicle windows</li>\n              <li>Armored car and transport construction</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Weather & Infrastructure -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-weather\" aria-labelledby=\"tab-weather\">\n            <ul class=\"applications__list\">\n              <li>Weather-rated glazing for tornado and hurricane zones</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
