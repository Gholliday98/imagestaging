          "elements": [
            {
              "id": "d4e5f6a3",
              "elType": "widget",
              "widgetType": "html",
              "isInner": false,
              "settings": {
                "html": "<section class=\"materials\" id=\"materials\">\n  <div class=\"materials__banner\">\n    <div class=\"container\">\n      <h2>Our Materials</h2>\n      <p>High-performance plastics for every pharmaceutical and research application</p>\n    </div>\n  </div>\n  <div class=\"materials__grid\">\n    <span class=\"material-tag\">Acrylic (PMMA)</span>\n    <span class=\"material-tag\">ABS</span>\n    <span class=\"material-tag\">HDPE</span>\n    <span class=\"material-tag\">Nylon (PA)</span>\n    <span class=\"material-tag\">PEEK</span>\n    <span class=\"material-tag\">PEI</span>\n    <span class=\"material-tag\">PES</span>\n    <span class=\"material-tag\">PETG</span>\n    <span class=\"material-tag\">Polyethylene (PE)</span>\n    <span class=\"material-tag\">Polycarbonate (PC)</span>\n    <span class=\"material-tag\">Polypropylene (PP)</span>\n    <span class=\"material-tag\">Polystyrene (PS)</span>\n    <span class=\"material-tag\">PTFE</span>\n    <span class=\"material-tag\">PVC</span>\n    <span class=\"material-tag\">UHMW-PE</span>\n  </div>\n</section>"
              },
              "elements": []
            }
          ]
        }
      ]
    },
    {
      "id": "e5f6a7b1",
