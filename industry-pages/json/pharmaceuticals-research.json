              "isInner": false,
              "settings": {
                "html": "<section class=\"hero hero--image\" style=\"background-image: url('https://plastic-craft.com/wp-content/uploads/2026/02/image_02.jpg');\">\n  <div class=\"hero__content\">\n    <p class=\"hero__label\">Industry Solutions</p>\n    <h1 class=\"hero__title\">Pharmaceuticals &amp; Research</h1>\n    <hr class=\"hero__divider\">\n  </div>\n</section>"
