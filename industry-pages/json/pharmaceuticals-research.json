          "elements": [
            {
              "id": "e5f6a7b3",
              "elType": "widget",
              "widgetType": "html",
              "isInner": false,
              "settings": {
                "html": "<section class=\"advantages\" id=\"advantages\">\n  <div class=\"container\">\n    <div class=\"advantages__header\">\n      <h2>Advantages of Using Plastic-Craft</h2>\n      <p>Engineered plastics that outperform in demanding environments</p>\n    </div>\n    <div class=\"advantages__carousel\">\n      <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n      <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n      <div class=\"advantages__track\" id=\"advantagesTrack\">\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z\"/></svg>\n          </div>\n          <h3>Regulatory Compliance</h3>\n          <p>Meets FDA, USP, ISO, NSF, and 3A Dairy standards with antimicrobial and biocompatible options available.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n          </div>\n          <h3>Chemical Stability</h3>\n          <p>Chemical stability, corrosion resistance, and compatibility with sterilization, radiation, and CIP/SIP processes.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n          </div>\n          <h3>Lightweight Construction</h3>\n          <p>Lightweight construction for high-speed production using smaller drive motors.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n          </div>\n          <h3>Lubrication-Free</h3>\n          <p>Lubrication-free design to reduce maintenance and contamination risk.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n          </div>\n          <h3>Transparent Grades</h3>\n          <p>Transparent grades available for easy viewing during operations.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M2 17l10 5 10-5\"/><path d=\"M2 12l10 5 10-5\"/><path d=\"M12 2L2 7l10 5 10-5L12 2z\"/></svg>\n          </div>\n          <h3>Dimensional Precision</h3>\n          <p>Dimensional precision and machinability for custom-engineered components.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n          </div>\n          <h3>Long Wear Life</h3>\n          <p>Long wear life with limited wear on mating machine parts.</p>\n        </div>\n        <div class=\"advantage-card\">\n          <div class=\"advantage-card__icon\">\n            <svg viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n          </div>\n          <h3>Cost-Effective &amp; Durable</h3>\n          <p>Cost-effective, durable, and safe for all pharmaceutical and research environments.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n  </div>\n</section>"
              },
              "elements": []
            }
          ]
        }
      ]
    },
