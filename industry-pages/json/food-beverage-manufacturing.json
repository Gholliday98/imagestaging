        {
          "id": "602ee2a",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/image_03.jpg\" alt=\"Food and beverage manufacturing plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-mechanical\" id=\"tab-mechanical\">Mechanical Components</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-conveyor\" id=\"tab-conveyor\">Conveyor &amp; Processing</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-fluid\" id=\"tab-fluid\">Fluid &amp; Forming</button>\n          </div>\n\n          <!-- Panel: Mechanical Components -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-mechanical\" aria-labelledby=\"tab-mechanical\">\n            <ul class=\"applications__list\">\n              <li>Bushings, Bearings, Cams, &amp; Cam Guides</li>\n              <li>Gears &amp; Sprockets</li>\n              <li>Rollers</li>\n              <li>Star Wheels</li>\n              <li>Pistons / Plungers</li>\n              <li>Sealers, Seats, &amp; Gaskets</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Conveyor & Processing -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-conveyor\" aria-labelledby=\"tab-conveyor\">\n            <ul class=\"applications__list\">\n              <li>Conveyor Parts</li>\n              <li>Feed Screws</li>\n              <li>Guide Rails</li>\n              <li>Wear Strips</li>\n              <li>Machine Guards / Windows</li>\n              <li>Thermoformed Machine Housings</li>\n              <li>Scraper Blades</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Fluid & Forming -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-fluid\" aria-labelledby=\"tab-fluid\">\n            <ul class=\"applications__list\">\n              <li>Pipes and Tubes for Fluids</li>\n              <li>Nozzles / Dispensing Heads</li>\n              <li>Forming Dies</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
