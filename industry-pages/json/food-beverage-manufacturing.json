        {
          "id": "01aab4e",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Engineered plastics built for food-safe, high-speed production environments</p>\n      </div>\n\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <!-- Card 1 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; High-Speed</h3>\n            <p>Lightweight plastics enable high-speed production using smaller drive motors while maintaining a long wear life.</p>\n          </div>\n\n          <!-- Card 2 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n            </div>\n            <h3>Lubrication-Free</h3>\n            <p>Eliminates lubrication to reduce maintenance requirements and contamination risk in food environments.</p>\n          </div>\n\n          <!-- Card 3 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Chemical &amp; Heat Resistant</h3>\n            <p>Resistant to hot water, steam, and Clean-In-Place (CIP) and Sanitize-In-Place (SIP) cleaning chemicals.</p>\n          </div>\n\n          <!-- Card 4 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n            </div>\n            <h3>Transparent Grades</h3>\n            <p>Transparent options available for easy visual monitoring of machinery during operation.</p>\n          </div>\n\n          <!-- Card 5 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Long Wear Life</h3>\n            <p>Limited wear on food packaging and mating machine parts, extending equipment lifespan.</p>\n          </div>\n\n          <!-- Card 6 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z\"/></svg>\n            </div>\n            <h3>Regulatory Compliance</h3>\n            <p>Grades that comply with FDA, NSF, 3A Dairy, and other Federal Agency Regulations for food-contact applications.</p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Carousel Dots -->\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
