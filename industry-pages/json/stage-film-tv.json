        {
          "id": "14c4713",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">For over 30 years, Plastic-Craft has been involved in the creation of stage and set designs for feature films, Broadway shows, and even events like the Olympics. We have the capabilities to manufacture beautifully polished and aesthetic works of art from your drawings or CAD specifications.</p><p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">Designed to deliver exactly what you need &mdash; with attention to the details that matter most.</p>",
            "align": "center"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
    {
