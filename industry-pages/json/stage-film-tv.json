      "elements": [
        {
          "id": "62978d9",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Stage, film, and TV set design plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-set\" id=\"tab-set\">Set Design &amp; Props</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-signage\" id=\"tab-signage\">Signage &amp; Displays</button>\n          </div>\n\n          <!-- Panel: Set Design & Props -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-set\" aria-labelledby=\"tab-set\">\n            <ul class=\"applications__list\">\n              <li>Custom fabricated set pieces</li>\n              <li>Optically clear materials</li>\n              <li>Detailed prop creation</li>\n              <li>Wall-mounted signs</li>\n              <li>Channel letters</li>\n              <li>Banners</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Signage & Displays -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-signage\" aria-labelledby=\"tab-signage\">\n            <ul class=\"applications__list\">\n              <li>Outdoor signage</li>\n              <li>Backlit / Electrical signs (LEDs)</li>\n              <li>Touch / Interactive signs</li>\n              <li>Sign boards (Menus)</li>\n              <li>Advertising (Indoor &amp; Outdoor)</li>\n              <li>Bus signs</li>\n              <li>Video walls</li>\n              <li>Digital signage</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
