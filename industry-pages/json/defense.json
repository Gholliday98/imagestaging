      "elements": [
        {
          "id": "eb72830",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Military defense plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-defense\" id=\"tab-defense\">Military Solutions</button>\n          </div>\n\n          <!-- Panel: Military Solutions -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-defense\" aria-labelledby=\"tab-defense\">\n            <ul class=\"applications__list\">\n              <li>Custom-fabricated parts for vehicles and equipment</li>\n              <li>Components meeting government regulations</li>\n              <li>High-impact resistant materials</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
    {
      "id": "99b32ed",
      "elType": "container",
      "settings": {
