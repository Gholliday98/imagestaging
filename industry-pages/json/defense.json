      "elements": [
        {
          "id": "3dc72be",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>High-performance plastics engineered for military-grade applications</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acetal (POM)</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Polyetheretherketone (PEEK)</span>\n      <span class=\"material-tag\">Polyethylene (PE)</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">Polyvinyl Chloride (PVC)</span>\n      <span class=\"material-tag\">Phenolic</span>\n      <span class=\"material-tag\">UHMW Polyethylene</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
    {
      "id": "6f4fa06",
      "elType": "container",
      "settings": {
