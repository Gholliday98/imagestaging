      "elements": [
        {
          "id": "623a661",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Precision-engineered plastics built to exceed military standards</p>\n      </div>\n\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <!-- Card 1 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n            </div>\n            <h3>Low Manufacturing Costs</h3>\n            <p>Cost-effective production for large quantities of consistent, precision-engineered components.</p>\n          </div>\n\n          <!-- Card 2 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n            </div>\n            <h3>High Purity &amp; Low Friction</h3>\n            <p>High purity materials with low friction and wear for demanding mechanical applications.</p>\n          </div>\n\n          <!-- Card 3 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; Durable</h3>\n            <p>Lightweight with excellent wear properties, resistant to high temperatures, impact, and chemicals.</p>\n          </div>\n\n          <!-- Card 4 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg>\n            </div>\n            <h3>Color Coding &amp; Ergonomics</h3>\n            <p>Color coding options and easy-to-create ergonomic designs for specialized military equipment.</p>\n          </div>\n\n          <!-- Card 5 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Thermal &amp; Chemical Stability</h3>\n            <p>Maintains physical properties under thermal, chemical, or electrical stress with excellent oxidative stability.</p>\n          </div>\n\n          <!-- Card 6 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z\"/></svg>\n            </div>\n            <h3>Regulatory Compliance</h3>\n            <p>Meets health regulations and precision dimensions. Can handle repeated sterilization with antimicrobial options.</p>\n          </div>\n\n          <!-- Card 7 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Abrasion &amp; Shatter Resistant</h3>\n            <p>Abrasion and shatter resistant materials built for the toughest military environments.</p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Carousel Dots -->\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
