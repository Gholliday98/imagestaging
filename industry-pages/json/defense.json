      "elements": [
        {
          "id": "fe78e58",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">Our nation&rsquo;s defense system is the backbone of this country and it is vital that their equipment is manufactured to rigorous standards. Plastic-Craft&rsquo;s staff engineers work with industry-standard CAD software to create designs with exacting precision.</p><p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">Our machinists can manufacture components to specifications with precise tolerances, and we can produce large quantities of consistent parts that meet and exceed strict government regulations.</p>",
            "align": "center"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
    {
      "id": "8e1dbb1",
      "elType": "container",
      "settings": {
