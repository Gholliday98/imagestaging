        {
          "id": "5602569",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Plastics that help farms operate more efficiently, sustainably, and profitably</p>\n      </div>\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\"/><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"/><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"/><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"/><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"/><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"/><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"/></svg>\n            </div>\n            <h3>Corrosion &amp; UV Resistant</h3>\n            <p>Corrosion and UV resistant for reliable outdoor performance in all weather conditions.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>High Impact &amp; Wear Resistance</h3>\n            <p>High impact and wear resistance that reduces sticking and carry-back in equipment.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Long-Lasting &amp; Recyclable</h3>\n            <p>Long-lasting with recyclable grades available for environmentally responsible farming.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n            </div>\n            <h3>Noise-Reducing &amp; Animal-Friendly</h3>\n            <p>Noise-reducing and animal-friendly materials suitable for livestock environments.</p>\n          </div>\n\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; Easy to Handle</h3>\n            <p>Lightweight and easy to handle for simplified installation and equipment servicing.</p>\n          </div>\n\n        </div>\n      </div>\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
