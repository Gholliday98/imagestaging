          "right": "0",
          "bottom": "0",
          "left": "0",
          "isLinked": true
        }
      },
      "elements": [
        {
          "id": "ac34dd8",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Agriculture and farming plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-farming\" id=\"tab-farming\">Farming &amp; Irrigation</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-structures\" id=\"tab-structures\">Structures &amp; Storage</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-farming\" aria-labelledby=\"tab-farming\">\n            <ul class=\"applications__list\">\n              <li>Irrigation pipes, valves, and nozzles</li>\n              <li>Livestock and poultry feeders, bins, and drinking systems</li>\n              <li>Harvesting and planting equipment: seed boxes, bearings, slide pads</li>\n              <li>Augers, chutes, skid plates, and liners</li>\n              <li>Spray system seals and bearings</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-structures\" aria-labelledby=\"tab-structures\">\n            <ul class=\"applications__list\">\n              <li>Greenhouse panels, skylights, and roofing</li>\n              <li>Storage tanks, hoppers, and bins</li>\n              <li>Barn partitions, skylights, and roofing systems</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
