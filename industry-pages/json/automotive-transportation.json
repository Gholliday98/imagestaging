      "elements": [
        {
          "id": "50b698d",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Automotive and transportation plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-auto\" id=\"tab-auto\">Automotive</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-transit\" id=\"tab-transit\">Transit &amp; Commercial</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-auto\" aria-labelledby=\"tab-auto\">\n            <ul class=\"applications__list\">\n              <li>Powertrain and transmission parts</li>\n              <li>Bearings, bushings, and gears</li>\n              <li>Wheel well liners, trunk liners, and bed liners</li>\n              <li>Dashboard and interior panels</li>\n              <li>EV charging stations and housings</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-transit\" aria-labelledby=\"tab-transit\">\n            <ul class=\"applications__list\">\n              <li>Truck liners, wear pads, and protective shields</li>\n              <li>Bus and railcar glazing, wall panels, and seating components</li>\n              <li>RV body panels, wear pads, and windshields</li>\n              <li>Marine panels, decking, and seals</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
