          "id": "088c649",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>High-performance plastics for automotive and transportation systems</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Nylon (PA)</span>\n      <span class=\"material-tag\">PET</span>\n      <span class=\"material-tag\">PBT</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">PEEK</span>\n      <span class=\"material-tag\">Polyurethane (PUR)</span>\n      <span class=\"material-tag\">PEI</span>\n      <span class=\"material-tag\">UHMW-PE</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
