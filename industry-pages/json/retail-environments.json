      },
      "elements": [
        {
          "id": "c6d7e8f",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Retail environment plastics and displays\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-displays\" id=\"tab-displays\">Displays &amp; Fixtures</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-barriers\" id=\"tab-barriers\">Barriers &amp; Protection</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-visual\" id=\"tab-visual\">Visual Merchandising</button>\n          </div>\n\n          <!-- Panel: Displays & Fixtures -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-displays\" aria-labelledby=\"tab-displays\">\n            <ul class=\"applications__list\">\n              <li>Point-of-Purchase (POP) Displays</li>\n              <li>Countertop Display Stands</li>\n              <li>Acrylic Shelving &amp; Shelf Dividers</li>\n              <li>Product Risers &amp; Pedestals</li>\n              <li>Brochure &amp; Literature Holders</li>\n              <li>Gondola End-Cap Displays</li>\n              <li>Modular Store Fixtures</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Barriers & Protection -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-barriers\" aria-labelledby=\"tab-barriers\">\n            <ul class=\"applications__list\">\n              <li>Checkout &amp; Cashier Barriers</li>\n              <li>Sneeze Guards &amp; Food Service Shields</li>\n              <li>Display Case Glazing</li>\n              <li>Anti-Theft Product Enclosures</li>\n              <li>Protective Counter Shields</li>\n              <li>Partition Walls &amp; Dividers</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Visual Merchandising -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-visual\" aria-labelledby=\"tab-visual\">\n            <ul class=\"applications__list\">\n              <li>Backlit Sign Panels &amp; Light Boxes</li>\n              <li>Window Display Components</li>\n              <li>Price Tag &amp; Label Holders</li>\n              <li>Custom Brand Displays</li>\n              <li>Promotional &amp; Seasonal Displays</li>\n              <li>Menu Boards &amp; Directory Signs</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
