          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Crystal-clear, durable plastics engineered for high-traffic retail environments</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">PETG</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">Polystyrene (PS)</span>\n      <span class=\"material-tag\">PVC</span>\n      <span class=\"material-tag\">Polyethylene (PE)</span>\n    </div>\n  </section>"
          },
