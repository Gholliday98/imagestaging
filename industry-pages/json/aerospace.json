          "id": "5fddc43",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Flight-grade polymers engineered for extreme conditions</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">PEEK</span>\n      <span class=\"material-tag\">PI</span>\n      <span class=\"material-tag\">PPS</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">POM</span>\n      <span class=\"material-tag\">PEI</span>\n      <span class=\"material-tag\">PTFE</span>\n      <span class=\"material-tag\">PVC</span>\n      <span class=\"material-tag\">Phenolic Composites</span>\n    </div>\n  </section>"
          },
