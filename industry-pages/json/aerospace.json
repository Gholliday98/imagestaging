        {
          "id": "853cf92",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/aerospace2.jpeg\" alt=\"Aerospace plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-structural\" id=\"tab-structural\">Structural &amp; Exterior</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-interior\" id=\"tab-interior\">Interior &amp; Systems</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-structural\" aria-labelledby=\"tab-structural\">\n            <ul class=\"applications__list\">\n              <li>Aircraft landing gear components</li>\n              <li>Transparent windows, canopies, and dust covers</li>\n              <li>Fasteners, seals, bushings, and bearings</li>\n              <li>Mirrors and dust covers</li>\n              <li>Electrical and thermal insulators</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-interior\" aria-labelledby=\"tab-interior\">\n            <ul class=\"applications__list\">\n              <li>Interior wall panels and luggage compartments</li>\n              <li>Ventilation ducting and collapsible ribs</li>\n              <li>Food trays and tray tables</li>\n              <li>Pipes, tubing, and wiring conduits</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
