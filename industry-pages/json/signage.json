      "elements": [
        {
          "id": "1f19fb0",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Signage and display plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-outdoor\" id=\"tab-outdoor\">Outdoor &amp; Transit</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-indoor\" id=\"tab-indoor\">Indoor &amp; Retail</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-specialty\" id=\"tab-specialty\">Specialty &amp; Custom</button>\n          </div>\n\n          <!-- Panel: Outdoor & Transit -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-outdoor\" aria-labelledby=\"tab-outdoor\">\n            <ul class=\"applications__list\">\n              <li>Outdoor Signage</li>\n              <li>Backlit / Electrical Signs (LEDs)</li>\n              <li>Channel Letters</li>\n              <li>Banners</li>\n              <li>Bus Signs (Mobile / Shelter)</li>\n              <li>DOT &amp; Construction Signage</li>\n              <li>Real Estate Signage</li>\n              <li>Advertising (Indoor / Outdoor)</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Indoor & Retail -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-indoor\" aria-labelledby=\"tab-indoor\">\n            <ul class=\"applications__list\">\n              <li>Wall Mounted Signs</li>\n              <li>Sign Boards (Menu Boards)</li>\n              <li>Countertop Signs</li>\n              <li>Free Standing Signs</li>\n              <li>Indoor POP Signage (Retail)</li>\n              <li>Video Walls</li>\n              <li>Window Graphics</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Specialty & Custom -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-specialty\" aria-labelledby=\"tab-specialty\">\n            <ul class=\"applications__list\">\n              <li>Touch / Interactive Signs</li>\n              <li>Digital Signage</li>\n              <li>Safety &amp; Emergency Signage</li>\n              <li>Directional Signage</li>\n              <li>ADA Signage</li>\n              <li>Custom Fabricated Displays</li>\n              <li>In-House Silk Screening</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
