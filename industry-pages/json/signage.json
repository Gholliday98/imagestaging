          "id": "dc5f3b9",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Durable, weather-resistant plastics for every signage application</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Polyethylene (PE)</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">Polystyrene (PS)</span>\n      <span class=\"material-tag\">Polyurethane (PU/PUR)</span>\n      <span class=\"material-tag\">Polyvinyl Chloride (PVC)</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
