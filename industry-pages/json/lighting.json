        {
          "id": "8324e1e",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Lighting system plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-optical\" id=\"tab-optical\">Optical Components</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-fixtures\" id=\"tab-fixtures\">Fixtures &amp; Enclosures</button>\n          </div>\n\n          <!-- Panel: Optical Components -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-optical\" aria-labelledby=\"tab-optical\">\n            <ul class=\"applications__list\">\n              <li>LED housings and light fixtures</li>\n              <li>Optical lenses and reflectors</li>\n              <li>Light diffusers and louvers</li>\n              <li>Automotive headlight and taillight covers</li>\n              <li>Safety shields and protective lenses</li>\n              <li>Transparent enclosures for electronics and lighting</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Fixtures & Enclosures -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-fixtures\" aria-labelledby=\"tab-fixtures\">\n            <ul class=\"applications__list\">\n              <li>Streetlight and outdoor enclosures</li>\n              <li>Industrial lighting housings and panels</li>\n              <li>Architectural lighting systems</li>\n              <li>Retail display lighting and illuminated signage</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
