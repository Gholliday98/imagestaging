            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Optically clear, heat-resistant plastics for modern lighting technology</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">PETG</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">PPS</span>\n      <span class=\"material-tag\">PEI</span>\n    </div>\n  </section>"
