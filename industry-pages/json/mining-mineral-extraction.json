          "id": "be926a3",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Abrasion-resistant plastics built for the toughest mining environments</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">UHMW-PE</span>\n      <span class=\"material-tag\">HDPE</span>\n      <span class=\"material-tag\">Nylon (PA)</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">PEEK</span>\n      <span class=\"material-tag\">PPS</span>\n      <span class=\"material-tag\">FRP</span>\n      <span class=\"material-tag\">PVC</span>\n      <span class=\"material-tag\">ABS</span>\n    </div>\n  </section>"
