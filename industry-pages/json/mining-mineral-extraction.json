      "elements": [
        {
          "id": "301498a",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/mining2.jpeg\" alt=\"Mining and mineral extraction plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-convey\" id=\"tab-convey\">Conveyor &amp; Equipment</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-process\" id=\"tab-process\">Processing &amp; Safety</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-convey\" aria-labelledby=\"tab-convey\">\n            <ul class=\"applications__list\">\n              <li>Conveyor components: gears, rollers, bushings, and sprockets</li>\n              <li>Wear pads, liners, and chute scrapers</li>\n              <li>Truck beds, hoppers, and car liners</li>\n              <li>Mining pump lantern rings and seals</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-process\" aria-labelledby=\"tab-process\">\n            <ul class=\"applications__list\">\n              <li>Chemical delivery pipe systems and dewatering systems</li>\n              <li>Leachate systems and vibrating bin dischargers</li>\n              <li>Precious metal recovery and flotation systems</li>\n              <li>Safety glazing, windshields, and protective barriers</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
