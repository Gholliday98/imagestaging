      "elements": [
        {
          "id": "b8dbf4a",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Education and school plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-classroom\" id=\"tab-classroom\">Classroom &amp; Lab</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-facility\" id=\"tab-facility\">Facility &amp; Outdoor</button>\n          </div>\n\n          <!-- Panel: Classroom & Lab -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-classroom\" aria-labelledby=\"tab-classroom\">\n            <ul class=\"applications__list\">\n              <li>Classroom partitions and dividers</li>\n              <li>Student desks and workstations</li>\n              <li>Laboratory countertops &amp; equipment</li>\n              <li>Safety shields for experiments</li>\n              <li>Whiteboards and bulletin boards</li>\n              <li>Storage bins &amp; organizers</li>\n              <li>Protective coverings for books &amp; documents</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Facility & Outdoor -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-facility\" aria-labelledby=\"tab-facility\">\n            <ul class=\"applications__list\">\n              <li>Glazing for windows and doors</li>\n              <li>Signage and display boards</li>\n              <li>Durable play equipment &amp; toys</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
