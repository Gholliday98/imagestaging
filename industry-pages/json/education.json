  "content": "<!-- ====== HERO — Background image with left-aligned title ====== -->\n  <section class=\"hero hero--image\" style=\"background-image: url('https://plastic-craft.com/wp-content/uploads/2026/02/image_07.jpg');\">\n\n    <div class=\"hero__content\">\n      <p class=\"hero__label\">Industry Solutions</p>\n      <h1 class=\"hero__title\">Education</h1>\n      <hr class=\"hero__divider\">\n    </div>\n  </section>\n\n  <!-- ====== INTRO TEXT ====== -->\n  <section class=\"intro intro--tight\">\n    <div class=\"container\">\n      <div class=\"intro__content\">\n        <p>Plastic-Craft has been a trusted supplier of school materials for over 30 years.</p>\n        <p>From durable playground materials, to classroom dividers, all the way to school infrastructure &mdash; we specialize in providing durable, safe, and reliable plastic solutions to schools.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== APPLICATIONS (Image + Tabbed Lists) ====== -->\n  <section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Education and school plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-classroom\" id=\"tab-classroom\">Classroom &amp; Lab</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-facility\" id=\"tab-facility\">Facility &amp; Outdoor</button>\n          </div>\n\n          <!-- Panel: Classroom & Lab -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-classroom\" aria-labelledby=\"tab-classroom\">\n            <ul class=\"applications__list\">\n              <li>Classroom partitions and dividers</li>\n              <li>Student desks and workstations</li>\n              <li>Laboratory countertops &amp; equipment</li>\n              <li>Safety shields for experiments</li>\n              <li>Whiteboards and bulletin boards</li>\n              <li>Storage bins &amp; organizers</li>\n              <li>Protective coverings for books &amp; documents</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Facility & Outdoor -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-facility\" aria-labelledby=\"tab-facility\">\n            <ul class=\"applications__list\">\n              <li>Glazing for windows and doors</li>\n              <li>Signage and display boards</li>\n              <li>Durable play equipment &amp; toys</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== MATERIALS (Banner bar + Tag Grid) ====== -->\n  <section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Safe, durable plastics designed for educational environments</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acrylic (PMMA) &mdash; Clear &amp; Mirrored</span>\n      <span class=\"material-tag\">Polycarbonate (PC) &mdash; High Impact</span>\n      <span class=\"material-tag\">High-Density Polyethylene (HDPE)</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">Expanded PVC</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">PETG &mdash; Transparent &amp; Shatterproof</span>\n      <span class=\"material-tag\">Fiberglass Reinforced Panels (FRP)</span>\n    </div>\n  </section>\n\n  <!-- ====== ADVANTAGES (Card Carousel) ====== -->\n  <section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Safe, durable, and cost-effective solutions built for schools</p>\n      </div>\n\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <!-- Card 1 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; Easy to Install</h3>\n            <p>Lightweight materials that are easy to install for teachers and school staff.</p>\n          </div>\n\n          <!-- Card 2 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Durable &amp; Wear Resistant</h3>\n            <p>Durable and resistant to wear and tear in high-traffic school environments.</p>\n          </div>\n\n          <!-- Card 3 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Safe for Students</h3>\n            <p>Non-toxic and shatterproof materials that meet safety and environmental standards.</p>\n          </div>\n\n          <!-- Card 4 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M2 17l10 5 10-5\"/><path d=\"M2 12l10 5 10-5\"/><path d=\"M12 2L2 7l10 5 10-5L12 2z\"/></svg>\n            </div>\n            <h3>Customizable</h3>\n            <p>Customizable for various educational needs with weather and corrosion resistance for outdoor use.</p>\n          </div>\n\n          <!-- Card 5 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/></svg>\n            </div>\n            <h3>Eco-Friendly Options</h3>\n            <p>Recyclable and environmentally friendly options available for sustainability-focused schools.</p>\n          </div>\n\n          <!-- Card 6 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n            </div>\n            <h3>Low-Maintenance &amp; Cost-Effective</h3>\n            <p>Impact-resistant for high-traffic areas with low maintenance and cost-effective pricing.</p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Carousel Dots -->\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n\n    </div>\n  </section>\n\n  <!-- ====== CTA / CONTACT ====== -->\n  <section class=\"cta-section\">\n    <div class=\"container\">\n      <h2>Ready to Get Started?</h2>\n      <p>Our specialist team is ready to supply safe, durable plastic solutions for your school&rsquo;s classroom, playground, and infrastructure needs.</p>\n      <div class=\"cta-section__actions\">\n        <a href=\"#\" class=\"btn btn--primary\">Request a Quote</a>\n        <a href=\"#\" class=\"btn btn--outline\">Contact Our Team</a>\n      </div>\n    </div>\n  </section>",
