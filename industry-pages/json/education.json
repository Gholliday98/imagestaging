          "id": "156058c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Safe, durable plastics designed for educational environments</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acrylic (PMMA) &mdash; Clear &amp; Mirrored</span>\n      <span class=\"material-tag\">Polycarbonate (PC) &mdash; High Impact</span>\n      <span class=\"material-tag\">High-Density Polyethylene (HDPE)</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">Expanded PVC</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">PETG &mdash; Transparent &amp; Shatterproof</span>\n      <span class=\"material-tag\">Fiberglass Reinforced Panels (FRP)</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
