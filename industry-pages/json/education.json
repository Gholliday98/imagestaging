        {
          "id": "ed846aa",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"advantages\" id=\"advantages\">\n    <div class=\"container\">\n      <div class=\"advantages__header\">\n        <h2>Advantages of Using Plastic-Craft</h2>\n        <p>Safe, durable, and cost-effective solutions built for schools</p>\n      </div>\n\n      <div class=\"advantages__carousel\">\n        <button class=\"advantages__arrow advantages__arrow--prev\" aria-label=\"Previous slide\">&larr;</button>\n        <button class=\"advantages__arrow advantages__arrow--next\" aria-label=\"Next slide\">&rarr;</button>\n\n        <div class=\"advantages__track\" id=\"advantagesTrack\">\n\n          <!-- Card 1 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n            </div>\n            <h3>Lightweight &amp; Easy to Install</h3>\n            <p>Lightweight materials that are easy to install for teachers and school staff.</p>\n          </div>\n\n          <!-- Card 2 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n            </div>\n            <h3>Durable &amp; Wear Resistant</h3>\n            <p>Durable and resistant to wear and tear in high-traffic school environments.</p>\n          </div>\n\n          <!-- Card 3 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Safe for Students</h3>\n            <p>Non-toxic and shatterproof materials that meet safety and environmental standards.</p>\n          </div>\n\n          <!-- Card 4 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M2 17l10 5 10-5\"/><path d=\"M2 12l10 5 10-5\"/><path d=\"M12 2L2 7l10 5 10-5L12 2z\"/></svg>\n            </div>\n            <h3>Customizable</h3>\n            <p>Customizable for various educational needs with weather and corrosion resistance for outdoor use.</p>\n          </div>\n\n          <!-- Card 5 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/></svg>\n            </div>\n            <h3>Eco-Friendly Options</h3>\n            <p>Recyclable and environmentally friendly options available for sustainability-focused schools.</p>\n          </div>\n\n          <!-- Card 6 -->\n          <div class=\"advantage-card\">\n            <div class=\"advantage-card__icon\">\n              <svg viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n            </div>\n            <h3>Low-Maintenance &amp; Cost-Effective</h3>\n            <p>Impact-resistant for high-traffic areas with low maintenance and cost-effective pricing.</p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Carousel Dots -->\n      <div class=\"advantages__dots\" id=\"advantagesDots\"></div>\n\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
