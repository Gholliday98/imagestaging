        {
          "id": "22e344a",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>UV and saltwater resistant plastics engineered for the marine environment</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">Acrylic (PMMA)</span>\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">High-Density Polyethylene (HDPE)</span>\n      <span class=\"material-tag\">Nylon (PA)</span>\n      <span class=\"material-tag\">Phenolic</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">Polyethylene Terephthalate (PET)</span>\n      <span class=\"material-tag\">Polyurethane (PU/PUR)</span>\n      <span class=\"material-tag\">Polyvinyl Chloride (PVC)</span>\n      <span class=\"material-tag\">UHMW Polyethylene</span>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
