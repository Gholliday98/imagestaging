      "elements": [
        {
          "id": "a364b0c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n\n        <!-- Featured Image -->\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/boatsdocksmarinas2.jpeg\" alt=\"Boats, docks, and marina plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n\n        <!-- Tabbed Application Lists -->\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-hull\" id=\"tab-hull\">Hull &amp; Deck</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-mechanical\" id=\"tab-mechanical\">Mechanical &amp; Electrical</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-dock\" id=\"tab-dock\">Dock &amp; Accessories</button>\n          </div>\n\n          <!-- Panel: Hull & Deck -->\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-hull\" aria-labelledby=\"tab-hull\">\n            <ul class=\"applications__list\">\n              <li>Cowls</li>\n              <li>Fairings</li>\n              <li>Swim Platforms</li>\n              <li>Decking</li>\n              <li>Gangways and Steps</li>\n              <li>Grab Rails and Handles</li>\n              <li>Windows</li>\n              <li>Cabinetry</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Mechanical & Electrical -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-mechanical\" aria-labelledby=\"tab-mechanical\">\n            <ul class=\"applications__list\">\n              <li>Fuel Lines</li>\n              <li>Rudder and Stern Shaft Bearings</li>\n              <li>Deck Machinery Bushings and Linear Bearings</li>\n              <li>Pump Bearings</li>\n              <li>Pulleys and Sheaves</li>\n              <li>Switch Board Panels</li>\n              <li>Relay Bases</li>\n              <li>Sealing</li>\n            </ul>\n          </div>\n\n          <!-- Panel: Dock & Accessories -->\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-dock\" aria-labelledby=\"tab-dock\">\n            <ul class=\"applications__list\">\n              <li>Fishing Rod Holders and Racks</li>\n              <li>Bait Tanks</li>\n              <li>Boat and Dock Bumpers</li>\n              <li>Custom Cutting Boards</li>\n              <li>Plastic Restoration</li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
