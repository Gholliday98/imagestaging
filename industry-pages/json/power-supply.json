      "elements": [
        {
          "id": "b8246e1",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"applications\" id=\"applications\">\n    <div class=\"container\">\n      <div class=\"applications__layout\">\n        <div class=\"applications__image\">\n          <!-- PLACEHOLDER: Replace src with your own image -->\n          <img src=\"\" alt=\"Power supply and electrical plastics\" loading=\"lazy\" style=\"background:#d0e9fd;min-height:480px;\">\n        </div>\n        <div class=\"applications__body\">\n          <h2>Our Applications</h2>\n          <div class=\"applications__tabs\" role=\"tablist\">\n            <button class=\"applications__tab active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-electrical\" id=\"tab-electrical\">Electrical Systems</button>\n            <button class=\"applications__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-renewable\" id=\"tab-renewable\">Renewable Energy</button>\n          </div>\n\n          <div class=\"applications__panel active\" role=\"tabpanel\" id=\"panel-electrical\" aria-labelledby=\"tab-electrical\">\n            <ul class=\"applications__list\">\n              <li>Wire and cable insulation</li>\n              <li>Plenum-rated cable jacketing</li>\n              <li>Circuit boards and wiring boards</li>\n              <li>Connectors for data, automotive, and telecom</li>\n              <li>High-voltage breaker housings</li>\n              <li>Aircraft electrical insulators</li>\n              <li>Radar lenses and test sockets</li>\n            </ul>\n          </div>\n\n          <div class=\"applications__panel\" role=\"tabpanel\" id=\"panel-renewable\" aria-labelledby=\"tab-renewable\">\n            <ul class=\"applications__list\">\n              <li>Solar array pivot bearings and housings</li>\n              <li>Wind turbine bearings and structural components</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>"
          },
