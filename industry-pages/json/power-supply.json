          "widgetType": "html",
          "settings": {
            "html": "<section class=\"materials\" id=\"materials\">\n    <div class=\"materials__banner\">\n      <div class=\"container\">\n        <h2>Our Materials</h2>\n        <p>Insulating, heat-resistant plastics for electrical and power generation systems</p>\n      </div>\n    </div>\n    <div class=\"materials__grid\">\n      <span class=\"material-tag\">ABS</span>\n      <span class=\"material-tag\">PBT</span>\n      <span class=\"material-tag\">Polycarbonate (PC)</span>\n      <span class=\"material-tag\">PEEK</span>\n      <span class=\"material-tag\">Polyethylene (PE)</span>\n      <span class=\"material-tag\">PET</span>\n      <span class=\"material-tag\">Polypropylene (PP)</span>\n      <span class=\"material-tag\">PPS</span>\n      <span class=\"material-tag\">PVC</span>\n      <span class=\"material-tag\">Thermoset Composites</span>\n    </div>\n  </section>"
          },
