        {
          "id": "e5f6a7b",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<style>\n.applications{background:#fff;padding:0;margin:0;font-family:'Montserrat',sans-serif}\n.applications .section-header{text-align:center;padding:56px 40px 32px}\n.applications .section-header h2{font-family:'Montserrat',sans-serif;font-size:1.55rem;font-weight:700;color:#1B365D;text-transform:uppercase;letter-spacing:2.5px;margin:0 0 10px}\n.applications .section-header .accent-bar{width:48px;height:3px;background:#1B365D;margin:0 auto 16px;border-radius:2px}\n.applications .section-header p{font-family:'Lora',serif;font-size:1.05rem;color:#4A5568;max-width:540px;margin:0 auto;line-height:1.7}\n.applications .app-showcase{display:flex;align-items:stretch;min-height:420px;background:#F7F8FA}\n.applications .app-image{flex:0 0 45%;position:relative;overflow:hidden}\n.applications .app-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}\n.applications .app-image:hover img{transform:scale(1.03)}\n.applications .app-content{flex:1;display:flex;flex-direction:column;justify-content:center;padding:48px 56px}\n.applications .tab-nav{display:flex;gap:0;margin-bottom:28px;border-bottom:2px solid #E2E8F0}\n.applications .tab-btn{font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#94A3B8;background:none;border:none;padding:10px 20px 12px;cursor:pointer;position:relative;transition:color .25s}\n.applications .tab-btn::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:2px;background:#1B365D;transform:scaleX(0);transition:transform .25s}\n.applications .tab-btn.active{color:#1B365D}\n.applications .tab-btn.active::after{transform:scaleX(1)}\n.applications .tab-btn:hover{color:#1B365D}\n.applications .tab-panel{display:none;animation:fadeTab .4s ease}\n.applications .tab-panel.active{display:block}\n@keyframes fadeTab{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n.applications .tab-panel h3{font-family:'Montserrat',sans-serif;font-size:.95rem;font-weight:700;color:#1B365D;text-transform:uppercase;letter-spacing:1.5px;margin:0 0 14px}\n.applications .tab-panel ul{list-style:none;padding:0;margin:0}\n.applications .tab-panel li{position:relative;padding:6px 0 6px 20px;font-family:'Lora',serif;font-size:.97rem;color:#4A5568;line-height:1.65}\n.applications .tab-panel li::before{content:'';position:absolute;left:0;top:13px;width:7px;height:7px;background:#1B365D;border-radius:50%}\n@media(max-width:768px){.applications .app-showcase{flex-direction:column}.applications .app-image{flex:0 0 auto;height:260px}.applications .app-content{padding:32px 24px}.applications .tab-btn{font-size:.65rem;padding:8px 12px 10px}}\n</style>\n<section class=\"applications\" id=\"applications\">\n  <div class=\"section-header\">\n    <h2>Applications</h2>\n    <div class=\"accent-bar\"></div>\n    <p>Versatile plastic solutions for every phase of production\u2014from concept to curtain call.</p>\n  </div>\n  <div class=\"app-showcase\">\n    <div class=\"app-image\">\n      <img src=\"https://plastic-craft.com/wp-content/uploads/2026/02/stagefilmtvprod2.jpeg\" alt=\"Stage, Film & TV Production applications\" loading=\"lazy\">\n    </div>\n    <div class=\"app-content\">\n      <div class=\"tab-nav\">\n        <button class=\"tab-btn active\" data-tab=\"sets-props\">Sets & Props</button>\n        <button class=\"tab-btn\" data-tab=\"lighting-fx\">Lighting & Effects</button>\n      </div>\n      <div id=\"sets-props\" class=\"tab-panel active\">\n        <h3>Sets & Props</h3>\n        <ul>\n          <li>Scenic flats, backdrops, and false walls</li>\n          <li>Lightweight prop replicas and hero props</li>\n          <li>Faux glass and breakaway panels for stunts</li>\n          <li>Architectural columns, moldings, and period details</li>\n          <li>Vacuum-formed terrain, vehicles, and furniture</li>\n          <li>CNC-routed dimensional logos and set dressing</li>\n        </ul>\n      </div>\n      <div id=\"lighting-fx\" class=\"tab-panel\">\n        <h3>Lighting & Effects</h3>\n        <ul>\n          <li>Light diffusion panels and custom gel frames</li>\n          <li>LED-backlit translucent walls and signage</li>\n          <li>Mirror and reflective surfaces for special effects</li>\n          <li>Colored transparent sheets for mood lighting</li>\n          <li>Projection screens and rear-projection surfaces</li>\n          <li>Protective shields and blast screens for pyrotechnics</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</section>"
          },
          "elements": []
        }
      ],
      "isInner": false
