          "id": "c9d0e1f",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<style>\n.advantages{background:#F7F8FA;padding:0;margin:0;font-family:'Montserrat',sans-serif}\n.advantages .section-header{text-align:center;padding:56px 40px 36px}\n.advantages .section-header h2{font-family:'Montserrat',sans-serif;font-size:1.55rem;font-weight:700;color:#1B365D;text-transform:uppercase;letter-spacing:2.5px;margin:0 0 10px}\n.advantages .section-header .accent-bar{width:48px;height:3px;background:#1B365D;margin:0 auto 16px;border-radius:2px}\n.advantages .section-header p{font-family:'Lora',serif;font-size:1.05rem;color:#4A5568;max-width:540px;margin:0 auto;line-height:1.7}\n.advantages .adv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;padding:0 48px 64px;max-width:1120px;margin:0 auto}\n.advantages .adv-card{background:#fff;border-radius:6px;padding:36px 30px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.06);transition:transform .25s,box-shadow .25s}\n.advantages .adv-card:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(0,0,0,.1)}\n.advantages .adv-icon{width:52px;height:52px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;background:#EEF2F7;border-radius:50%}\n.advantages .adv-icon svg{width:26px;height:26px;stroke:#1B365D;stroke-width:1.5;fill:none}\n.advantages .adv-title{font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:700;color:#1B365D;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px}\n.advantages .adv-desc{font-family:'Lora',serif;font-size:.92rem;color:#64748B;line-height:1.65}\n@media(max-width:768px){.advantages .adv-grid{grid-template-columns:1fr;padding:0 24px 48px}}\n</style>\n<section class=\"advantages\" id=\"advantages\">\n  <div class=\"section-header\">\n    <h2>Why Plastic-Craft</h2>\n    <div class=\"accent-bar\"></div>\n    <p>Built for the pace and precision the entertainment industry demands.</p>\n  </div>\n  <div class=\"adv-grid\">\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><circle cx=\"13\" cy=\"13\" r=\"10\"/><path d=\"M13 7v6l4 3\"/></svg></div>\n      <div class=\"adv-title\">Fast Turnaround</div>\n      <div class=\"adv-desc\">Rush orders and same-day cutting keep your production on schedule when deadlines are tight.</div>\n    </div>\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><rect x=\"3\" y=\"3\" width=\"20\" height=\"20\" rx=\"2\"/><path d=\"M3 13h20\"/></svg></div>\n      <div class=\"adv-title\">Custom Cut-to-Size</div>\n      <div class=\"adv-desc\">Sheets, rods, and tubes cut to your exact dimensions\u2014no waste, no delays on set.</div>\n    </div>\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><path d=\"M13 3l3 7h7l-5.5 4.5 2 7L13 17l-6.5 4.5 2-7L3 10h7z\"/></svg></div>\n      <div class=\"adv-title\">Optical Clarity</div>\n      <div class=\"adv-desc\">Crystal-clear acrylic and polycarbonate for camera-ready surfaces and on-screen realism.</div>\n    </div>\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><path d=\"M4 20V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14\"/><path d=\"M4 20h18\"/><circle cx=\"9\" cy=\"12\" r=\"3\"/></svg></div>\n      <div class=\"adv-title\">Lightweight & Durable</div>\n      <div class=\"adv-desc\">Easy to transport and rig on set while standing up to the demands of multi-day shoots.</div>\n    </div>\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><path d=\"M5 13a8 8 0 0 1 16 0\"/><circle cx=\"13\" cy=\"13\" r=\"3\"/><line x1=\"13\" y1=\"16\" x2=\"13\" y2=\"23\"/></svg></div>\n      <div class=\"adv-title\">Design Flexibility</div>\n      <div class=\"adv-desc\">Thermoformable, CNC-machinable, and paintable materials for any creative vision.</div>\n    </div>\n    <div class=\"adv-card\">\n      <div class=\"adv-icon\"><svg viewBox=\"0 0 26 26\"><path d=\"M12 3v4M4.93 6.93l2.83 2.83M3 14h4M4.93 21.07l2.83-2.83M12 25v-4M19.07 21.07l-2.83-2.83M21 14h4M19.07 6.93l-2.83 2.83\"/></svg></div>\n      <div class=\"adv-title\">Safety Rated</div>\n      <div class=\"adv-desc\">Breakaway-safe, fire-retardant, and UV-stable options for stunts, pyro, and outdoor stages.</div>\n    </div>\n  </div>\n</section>\n<script>\ndocument.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.tab-btn').forEach(function(btn){btn.addEventListener('click',function(){var t=this.getAttribute('data-tab');this.closest('.app-content').querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active')});this.classList.add('active');this.closest('.app-content').querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active')});document.getElementById(t).classList.add('active')})})});\n</script>"
          },
          "elements": []
        }
      ],
      "isInner": false
    },
